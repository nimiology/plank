{
  "name": "plank",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:reset": "bash scripts/reset-dev.sh",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && npx svelte-check-rs --tsconfig ./tsconfig.json --ignore 'docs/**' --ignore 'site/**' && npx ultracite fix && npm run knip",
    "check:watch": "svelte-kit sync && npx svelte-check-rs --tsconfig ./tsconfig.json --watch --ignore 'docs/**' && npx ultracite fix --watch && npm run knip",
    "test": "bun x vitest run",
    "test:watch": "bun x vitest",
    "test:coverage": "bun x vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip --include-entry-exports",
    "library:optimize": "tsx scripts/optimize-library.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@lucide/svelte": "0.575.0",
    "@sveltejs/adapter-node": "5.5.3",
    "@sveltejs/kit": "2.53.0",
    "@tanstack/svelte-query": "6.0.18",
    "@tanstack/svelte-query-devtools": "6.0.4",
    "@types/node-cron": "3.0.11",
    "better-auth": "1.4.17",
    "better-sqlite3": "12.6.2",
    "bits-ui": "2.19.0",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.8",
    "drizzle-orm": "^0.45.1",
    "fluent-ffmpeg": "2.1.3",
    "hls.js": "1.6.13",
    "jimp": "^1.6.0",
    "nanoid": "^5.1.16",
    "node-cron": "4.2.1",
    "parse-torrent": "11.0.19",
    "parse-torrent-title": "2.1.0",
    "svelte-sonner": "1.0.7",
    "tailwind-merge": "3.5.0",
    "vidstack": "^1.12.13",
    "webtorrent": "2.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.1.18",
    "@types/better-sqlite3": "7.6.13",
    "@types/fluent-ffmpeg": "2.1.28",
    "@vitest/coverage-v8": "4.0.17",
    "knip": "5.82.1",
    "lefthook": "2.0.15",
    "svelte": "5.48.0",
    "tailwindcss": "4.1.18",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "ultracite": "7.0.12",
    "vite": "7.3.1",
    "vitest": "^4.0.17"
  }
}
